# Optional: enables AI narrative analysis. Omit and run --no-ai for deterministic local analysis.
ANTHROPIC_API_KEY=your_anthropic_key_here
ANTHROPIC_MODEL=claude-sonnet-4-20250514

# CoralCon mode. Keep false for sample mode; set true after `coral source list`
# shows github, notion, and linkedin.
CORAL_AVAILABLE=false
USE_SAMPLE_DATA=true
CORALCON_QUERY_CACHE=false

# Local database mode. In sample/local mode CoralCon reads from this SQLite
# database by default. Set CORALCON_DATA_BACKEND=json to use raw JSON fixtures.
CORALCON_DATA_BACKEND=sqlite
CORALCON_DB_PATH=data/coralcon.sqlite

# Optional: public portfolio page CoralCon can inspect for visible skills,
# projects, and GitHub links. You can also pass --portfolio-url at runtime.
PORTFOLIO_URL=https://your-portfolio.example.com

# Coral read sources. These are consumed by `coral source add ...`, not directly
# by CoralCon after the sources are installed in Coral.
GITHUB_TOKEN=your_github_pat_here
NOTION_API_KEY=your_notion_internal_integration_token_here

# Optional: Notion writes for generated dashboard/action pages.
# Can be the same token as NOTION_API_KEY if that integration has write access.
NOTION_TOKEN=your_notion_internal_integration_token_here
NOTION_DASHBOARD_PAGE_ID=your_dashboard_page_id_here
NOTION_ACTIONS_DATABASE_ID=your_actions_database_id_here

# Optional: use this when your applications are a simple Notion table block
# rather than a Notion database/data source.
NOTION_APPLICATIONS_PAGE_ID=your_job_applications_page_id_here
NOTION_APPLICATIONS_TABLE_BLOCK_ID=your_table_block_id_here
